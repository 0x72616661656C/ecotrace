# URL pública do diretório criado por web/scripts/prepare_static_dataset.py.
# O bucket precisa permitir CORS (GET, HEAD e Range) para o domínio da Vercel.
VITE_DATASET_BASE_URL=https://cdn.example.com/ecotrace

# URLs públicas dos modelos ONNX; use /models/... se eles forem colocados em public/models.
VITE_UNET_MODEL_URL=https://cdn.example.com/ecotrace/models/unet.onnx
VITE_ATTN_UNET_MODEL_URL=https://cdn.example.com/ecotrace/models/attn_unet.onnx
